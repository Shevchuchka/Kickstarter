module.exports={header:{title:"Футуристична бездротова колонка",description:"Звучання Luna збалансоване й плавне у всьому діапазоні частот, що робить музику водночас природно приємною та помітно багатошаровою."},specs:{specs:"специф."},btn:{buy:"купити",send:"надіслати","see-more":"Дізнатися більше про нас"},menu:{"our-story":"НАША ІСТОРІЯ","about-us":"ПРО НАС",features:"ОСОБЛИВОСТІ","get-in-touch":"ЗВ'ЯЗАТИСЯ"},benefits:{futuristic_title:"Футуристичний дизайн",futuristic_prgrph:"Щоб надати Luna бездоганного вигляду, ми спеціально обрали алюміній високого класу та використали тривимірну технологію згинання з натягом і метод холодного кування з високою точністю.",tweeter_title:"Система високочастотних динаміків",tweeter_prgrph:"Щоб забезпечити багатошаровий звук кращий, ніж один широкосмуговий динамік, ми обладнали Luna ще одним твіттером, який відповідає за високочастотний звук окремо.",multiroom_title:"Система Multiroom",multiroom_prgrph:"Luna сумісна з домашнім Wi-Fi. Налаштуйте кілька динаміків у різних кімнатах для музичного досвіду по всьому дому.",intuitive_title:"Інтуїтивна система освітлення",intuitive_prgrph:"Інтуїтивний інтерфейс дозволяє регулювати відтінок і насиченість кольору для освітлення, що відповідає будь-якому настрою й ситуації."},"about-us":{future_title:"СТВОРЕНО ДЛЯ МАЙБУТНЬОГО",future_prgrph:"У 2014 році група дизайнерів, інженерів і звукових експертів заснувала crazybaby. Це команда пристрасних людей, які достатньо сміливі, щоб кинути виклик індустрії аудіо продуктів.",luna_title:"Luna Eye",luna_prgrph:"Luna Eye — це суть цієї інноваційної системи світла та звуку. Вона складається з незалежного твіттера, світлового елемента, купола та декоративного кільця."},quotes:{quote:"“Мене справді вразило, наскільки повний і красивий звук виходить із цього маленького компактного пристрою. А завдяки шліфованій алюмінієвій поверхні, він здається таким знайомим. Як мій iPhone.”",name:"Ґаррет Мартін",position:"Креативний директор"},features:{title:"ОСОБЛИ